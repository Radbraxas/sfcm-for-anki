{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "sfcm-for-anki",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "app/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "json", "path": "ui/package.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "engine/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "generic", "path": "engine/src/sfcm_engine/__init__.py" }
      ]
    }
  }
}
